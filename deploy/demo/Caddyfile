# Between the tunnel and Rustybin. Only Cloudflare reaches this, and it overwrites
# Cf-Connecting-Ip and X-Forwarded-Proto, so a visitor can name neither.
{
	admin off
	auto_https off
}

:8080 {
	# Sign-in and visitors stay on https: this instance never answers plain http.
	@plain header X-Forwarded-Proto http
	redir @plain https://{host}{uri} 308

	reverse_proxy rustybin:8080 {
		header_up X-Real-IP {http.request.header.Cf-Connecting-Ip}
		header_up X-Forwarded-Proto https
	}
}
